_booked,2)\n + cleaning_fee + service_fee as total_amount,\n    booking_status,\n    created_at,\n    current_timestamp() as _loaded_at\nfrom AIRBNB.bronze.bronze_bookings", "relation_name": "AIRBNB.silver.silver_bookings", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-19T09:11:17.395503Z", "completed_at": "2026-10-19T09:11:17.399615Z"}, {"name": "execute", "started_at": "2026-10-19T09:11:17.400258Z", "completed_at": "2026-10-19T09:11:19.209752Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 1.8161637783050537, "adapter_response": {"_message": "SUCCESS 200", "code": "SUCCESS", "rows_affected": 200, "query_id": "01c7d4c7-000e-1767-0002-504e0022f15a", "rows_inserted": 0, "rows_deleted": 0, "rows_updated": 200, "rows_duplicates": 0}, "message": "SUCCESS 200", "failures": null, "unique_id": "model.aws_dbt_snowflake_project.silver_hosts", "compiled": true, "compiled_code": "\n\nselect\n    host_id,\n    replace(host_name, ' ', '_') as host_name,\n    host_since,\n    is_superhost,\n    case \n        when response_rate > 95 then 'excellent'\n        when response_rate > 80 then 'good'\n        when response_rate > 60 then 'fair'\n        else 'poor'\n    end as response_rate,\n    created_at,\n    current_timestamp() as _loaded_at\nfrom AIRBNB.bronze.bronze_hosts", "relation_name": "AIRBNB.silver.silver_hosts", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-19T09:11:19.214698Z", "completed_at": "2026-10-19T09:11:19.220778Z"}, {"name": "execute", "started_at": "2026-10-19T09:11:19.221363Z", "completed_at": "2026-10-19T09:11:21.219048Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 2.005551815032959, "adapter_response": {"_message": "SUCCESS 500", "code": "SUCCESS", "rows_affected": 500, "query_id": "01c7d4c7-000e-1789-0002-504e0022a1aa", "rows_inserted": 0, "rows_deleted": 0, "rows_updated": 500, "